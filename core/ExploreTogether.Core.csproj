<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine-independent game logic (maze generation, inventory rules, persistence).
       Must not reference Godot, so it can be unit-tested and reused by the server. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ExploreTogether.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>
</Project>
